# Ring Studio project. Notes live here and are never exported. Secrets are never stored here.
ring_studio: 1
name: Hands Clock
note: An analog clock that needs no entity. It stays on all night and dims with the sun instead (Off from is set
  to 24). Check the hands on the wall with Send this to the clock, then set the LED at 12 o'clock and the LED order
  to match your ring.
brightness:
  follow_the_sun: true
  off_from_hour: 24
  on_at_hour: 0
  dimmest: 10
  brightest: 90
  dimmest_at_sun_angle: -6.0
  brightest_at_sun_angle: 30.0
  clocks:
  - hands_clock
clocks:
- name: hands_clock
  display_name: Hands Clock
  effect: Hands Ring
  note: 'The hour hand and the minute hand light up, and their colour follows the time of day: deep blue at night,
    orange at sunrise, warm white at midday, gold in the afternoon, red at sunset and purple in the evening. The
    minute hand is a lighter version of the same colour. The four quarter marks glow faintly.'
  hardware:
    board: esp12e
    data_pin: GPIO12
    driver: bit_bang
    led_type: WS2812
    colour_order: GRB
    gamma: 1.0
    leds: 36
    max_brightness: 90
    start_brightness: 40
  shows:
    layout: hands
    entity: ''
    list_attributes: []
    item_key: ''
    start_time_key: ''
    end_time_key: ''
    multiply_by: 1.0
    low: 0.0
    high: 100.0
    now_marker: bright
    other_leds: 0.15
    led_at_12_oclock: 0
    clockwise: true
    palette:
    - '#1A1A80'
    - '#2A1060'
    - '#FF6020'
    - '#FFB040'
    - '#FFE6B0'
    - '#FFC860'
    - '#FF5030'
    - '#6020A0'
    below_range: null
    unknown_state: '#646464'
    no_data: '#000000'
    states: {}
