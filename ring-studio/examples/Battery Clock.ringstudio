# Ring Studio project. Notes live here and are never exported. Secrets are never stored here.
ring_studio: 1
name: Battery Clock
note: Example project with one battery clock.
brightness:
  follow_the_sun: true
  off_from_hour: 23
  on_at_hour: 6
  dimmest: 10
  brightest: 90
  dimmest_at_sun_angle: -6.0
  brightest_at_sun_angle: 30.0
  clocks:
  - battery_clock
clocks:
- name: battery_clock
  display_name: Battery Clock
  effect: Battery Ring
  note: Fills the ring with a battery level, red when low and green when full. Set the entity to your device.
  hardware:
    board: esp12e
    data_pin: GPIO12
    driver: bit_bang
    led_type: WS2812
    colour_order: GRB
    gamma: 1.0
    leds: 36
    max_brightness: 90
    start_brightness: 40
  shows:
    layout: gauge
    entity: sensor.phone_battery_level
    list_attributes: []
    item_key: ''
    start_time_key: ''
    end_time_key: ''
    multiply_by: 1.0
    low: 0.0
    high: 100.0
    now_marker: bright
    other_leds: 0.55
    palette:
    - '#FF0040'
    - '#FF4500'
    - '#FFA500'
    - '#FFD700'
    - '#7CFC00'
    - '#00C853'
    below_range: null
    unknown_state: '#646464'
    no_data: '#000000'
    states: {}
