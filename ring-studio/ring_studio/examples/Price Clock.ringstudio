# Ring Studio project. Notes live here and are never exported. Secrets are never stored here.
ring_studio: 1
name: Price Clock
note: Example project with one price clock.
brightness:
  follow_the_sun: true
  off_from_hour: 23
  on_at_hour: 6
  dimmest: 10
  brightest: 90
  dimmest_at_sun_angle: -6.0
  brightest_at_sun_angle: 30.0
  clocks:
  - price_clock
clocks:
- name: price_clock
  display_name: Price Clock
  effect: Price Ring
  note: Spot prices for price area SE3 from the Swedish Spot Price integration, one LED per 15 minutes. Blue is
    cheap, red is expensive, white means below zero. Change the entity for another price area.
  hardware:
    board: esp12e
    data_pin: GPIO12
    driver: bit_bang
    led_type: WS2812
    colour_order: GRB
    gamma: 1.0
    leds: 36
    max_brightness: 90
    start_brightness: 40
  shows:
    layout: timeline
    entity: sensor.swedish_spot_price_elpris_se3_forecast
    list_attributes:
    - today
    - tomorrow
    item_key: SEK_per_kWh
    start_time_key: time_start
    end_time_key: time_end
    multiply_by: 100.0
    low: 0.0
    high: 100.0
    now_marker: bright
    other_leds: 0.55
    led_at_12_oclock: 0
    clockwise: true
    palette:
    - '#00BFFF'
    - '#0070FF'
    - '#0040FF'
    - '#4000FF'
    - '#8000FF'
    - '#B000FF'
    - '#FF00FF'
    - '#FF0080'
    - '#FF0040'
    below_range: '#FFFFFF'
    unknown_state: '#646464'
    no_data: '#000000'
    states: {}
