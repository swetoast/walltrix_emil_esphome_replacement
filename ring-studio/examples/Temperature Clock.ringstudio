# Ring Studio project. Notes live here and are never exported. Secrets are never stored here.
ring_studio: 1
name: Temperature Clock
note: Example project with one temperature clock.
brightness:
  follow_the_sun: true
  off_from_hour: 23
  on_at_hour: 6
  dimmest: 10
  brightest: 90
  dimmest_at_sun_angle: -6.0
  brightest_at_sun_angle: 30.0
  clocks:
  - temperature_clock
clocks:
- name: temperature_clock
  display_name: Temperature Clock
  effect: Temperature Ring
  note: Fills the ring from -20 to 30 degrees. Set the entity to your own outdoor temperature sensor.
  hardware:
    board: esp12e
    data_pin: GPIO12
    driver: bit_bang
    led_type: WS2812
    colour_order: GRB
    gamma: 1.0
    leds: 36
    max_brightness: 90
    start_brightness: 40
  shows:
    layout: gauge
    entity: sensor.outdoor_temperature
    list_attributes: []
    item_key: ''
    start_time_key: ''
    end_time_key: ''
    multiply_by: 1.0
    low: -20.0
    high: 30.0
    now_marker: bright
    other_leds: 0.55
    palette:
    - '#0000CD'
    - '#1E90FF'
    - '#40E0D0'
    - '#7CFC00'
    - '#FFD700'
    - '#FFA500'
    - '#FF0040'
    below_range: null
    unknown_state: '#646464'
    no_data: '#000000'
    states: {}
