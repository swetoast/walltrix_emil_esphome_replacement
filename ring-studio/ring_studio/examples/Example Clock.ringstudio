# Ring Studio project. Notes live here and are never exported. Secrets are never stored here.
ring_studio: 2
name: Example Clock
note: One clock with six designs. Open a design, change anything, then Apply to clock to show it. Designs that are
  not applied stay here for later.
clocks:
- id: 43aa3991
  name: my_clock
  display_name: My Clock
  effect: Ring
  note: Switch what it shows by picking a design on the left and pressing Apply to clock.
  hardware:
    board: esp12e
    data_pin: GPIO12
    driver: bit_bang
    led_type: WS2812
    colour_order: GRB
    gamma: 1.0
    leds: 36
    max_brightness: 90
    start_brightness: 40
    led_at_12_oclock: 0
    clockwise: true
  brightness:
    follow_the_sun: true
    off_from_hour: 23
    on_at_hour: 6
    dimmest: 10
    brightest: 90
    dimmest_at_sun_angle: -6.0
    brightest_at_sun_angle: 30.0
  shows: Electricity price
  designs:
  - name: Electricity price
    note: Spot prices for price area SE3 from the Swedish Spot Price integration, one LED per 15 minutes. Blue is
      cheap, red is expensive, white means below zero. Change the entity for another price area.
    layout: from_now
    entity: sensor.swedish_spot_price_elpris_se3_forecast
    value_attribute: ''
    list_attributes:
    - today
    - tomorrow
    item_key: SEK_per_kWh
    start_time_key: time_start
    end_time_key: time_end
    second_entity: ''
    second_attribute: ''
    multiply_by: 100.0
    low: 0.0
    high: 100.0
    colour_by: gradient
    now_marker: bright
    other_leds: 0.55
    palette:
    - '#00BFFF'
    - '#0070FF'
    - '#0040FF'
    - '#4000FF'
    - '#8000FF'
    - '#B000FF'
    - '#FF00FF'
    - '#FF0080'
    - '#FF0040'
    steps: []
    below_range: '#FFFFFF'
    unknown_state: '#646464'
    no_data: '#000000'
    states: {}
    parts: []
  - name: Weather
    note: 'Hourly forecast from sensor.weather_hourly on a 24-hour dial: midnight at the top and every hour in its
      own place, showing the next 24 hours. Warm colours are dry daytime, blues are rain, whites and cyans are snow
      and ice, purple is thunder, green is wind, red is exceptional.'
    layout: dial_24h
    entity: sensor.weather_hourly
    value_attribute: ''
    list_attributes:
    - forecast
    item_key: condition
    start_time_key: datetime
    end_time_key: ''
    second_entity: ''
    second_attribute: ''
    multiply_by: 1.0
    low: 0.0
    high: 100.0
    colour_by: values
    now_marker: bright
    other_leds: 0.4
    palette:
    - '#00BFFF'
    - '#0070FF'
    - '#0040FF'
    - '#4000FF'
    - '#8000FF'
    - '#B000FF'
    - '#FF00FF'
    - '#FF0080'
    - '#FF0040'
    steps: []
    below_range: null
    unknown_state: '#646464'
    no_data: '#000000'
    states:
      sunny:
        colour: '#FFB000'
        means: Sunny
        note: ''
      clear-night:
        colour: '#3020A0'
        means: Clear night
        note: Kept fairly bright so it still shows when the ring is dimmed at night.
      partlycloudy:
        colour: '#FFE6A0'
        means: Partly cloudy
        note: ''
      cloudy:
        colour: '#8090B0'
        means: Cloudy
        note: ''
      fog:
        colour: '#C8C0B0'
        means: Fog
        note: ''
      rainy:
        colour: '#0064FF'
        means: Rain
        note: ''
      pouring:
        colour: '#0010FF'
        means: Heavy rain
        note: ''
      snowy:
        colour: '#E0F0FF'
        means: Snow
        note: ''
      snowy-rainy:
        colour: '#80D0FF'
        means: Sleet
        note: ''
      hail:
        colour: '#40FFE0'
        means: Hail
        note: ''
      lightning:
        colour: '#A000FF'
        means: Thunder
        note: ''
      lightning-rainy:
        colour: '#6000FF'
        means: Thunder and rain
        note: ''
      windy:
        colour: '#00D090'
        means: Windy
        note: ''
      windy-variant:
        colour: '#40A090'
        means: Windy and cloudy
        note: ''
      exceptional:
        colour: '#FF2000'
        means: Exceptional
        note: Rare. Red is kept for this alone so it stands out.
    parts: []
  - name: Temperature
    note: Fills the ring from -20 to 30 degrees. Set the entity to your own outdoor temperature sensor.
    layout: fill
    entity: sensor.outdoor_temperature
    value_attribute: ''
    list_attributes: []
    item_key: ''
    start_time_key: ''
    end_time_key: ''
    second_entity: ''
    second_attribute: ''
    multiply_by: 1.0
    low: -20.0
    high: 30.0
    colour_by: gradient
    now_marker: bright
    other_leds: 0.55
    palette:
    - '#0000CD'
    - '#1E90FF'
    - '#40E0D0'
    - '#7CFC00'
    - '#FFD700'
    - '#FFA500'
    - '#FF0040'
    steps: []
    below_range: null
    unknown_state: '#646464'
    no_data: '#000000'
    states: {}
    parts: []
  - name: Battery
    note: Fills the ring with a battery level, red when low and green when full. Set the entity to your device.
    layout: fill
    entity: sensor.phone_battery_level
    value_attribute: ''
    list_attributes: []
    item_key: ''
    start_time_key: ''
    end_time_key: ''
    second_entity: ''
    second_attribute: ''
    multiply_by: 1.0
    low: 0.0
    high: 100.0
    colour_by: gradient
    now_marker: bright
    other_leds: 0.55
    palette:
    - '#FF0040'
    - '#FF4500'
    - '#FFA500'
    - '#FFD700'
    - '#7CFC00'
    - '#00C853'
    steps: []
    below_range: null
    unknown_state: '#646464'
    no_data: '#000000'
    states: {}
    parts: []
  - name: Calendar
    note: Red while a calendar event is running, green when free. Set the entity to your calendar.
    layout: whole_ring
    entity: calendar.home
    value_attribute: ''
    list_attributes: []
    item_key: ''
    start_time_key: ''
    end_time_key: ''
    second_entity: ''
    second_attribute: ''
    multiply_by: 1.0
    low: 0.0
    high: 100.0
    colour_by: values
    now_marker: bright
    other_leds: 0.55
    palette:
    - '#00BFFF'
    - '#0070FF'
    - '#0040FF'
    - '#4000FF'
    - '#8000FF'
    - '#B000FF'
    - '#FF00FF'
    - '#FF0080'
    - '#FF0040'
    steps: []
    below_range: null
    unknown_state: '#646464'
    no_data: '#000000'
    states:
      'on':
        colour: '#FF0040'
        means: Busy
        note: ''
      'off':
        colour: '#00C853'
        means: Free
        note: ''
    parts: []
  - name: Clock hands
    note: 'The hour hand and the minute hand light up, and their colour follows the time of day: deep blue at night,
      orange at sunrise, warm white at midday, gold in the afternoon, red at sunset and purple in the evening. The
      minute hand is a lighter version of the same colour. The four quarter marks glow faintly.'
    layout: hands
    entity: ''
    value_attribute: ''
    list_attributes: []
    item_key: ''
    start_time_key: ''
    end_time_key: ''
    second_entity: ''
    second_attribute: ''
    multiply_by: 1.0
    low: 0.0
    high: 100.0
    colour_by: gradient
    now_marker: bright
    other_leds: 0.15
    palette:
    - '#1A1A80'
    - '#2A1060'
    - '#FF6020'
    - '#FFB040'
    - '#FFE6B0'
    - '#FFC860'
    - '#FF5030'
    - '#6020A0'
    steps: []
    below_range: null
    unknown_state: '#646464'
    no_data: '#000000'
    states: {}
    parts: []
