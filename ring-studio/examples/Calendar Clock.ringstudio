# Ring Studio project. Notes live here and are never exported. Secrets are never stored here.
ring_studio: 1
name: Calendar Clock
note: Example project with one calendar clock.
brightness:
  follow_the_sun: true
  off_from_hour: 23
  on_at_hour: 6
  dimmest: 10
  brightest: 90
  dimmest_at_sun_angle: -6.0
  brightest_at_sun_angle: 30.0
  clocks:
  - calendar_clock
clocks:
- name: calendar_clock
  display_name: Calendar Clock
  effect: Calendar Ring
  note: Red while a calendar event is running, green when free. Set the entity to your calendar.
  hardware:
    board: esp12e
    data_pin: GPIO12
    driver: bit_bang
    led_type: WS2812
    colour_order: GRB
    gamma: 1.0
    leds: 36
    max_brightness: 90
    start_brightness: 40
  shows:
    layout: state
    entity: calendar.home
    list_attributes: []
    item_key: ''
    start_time_key: ''
    end_time_key: ''
    multiply_by: 1.0
    low: 0.0
    high: 100.0
    now_marker: bright
    other_leds: 0.55
    led_at_12_oclock: 0
    clockwise: true
    palette:
    - '#00BFFF'
    - '#0070FF'
    - '#0040FF'
    - '#4000FF'
    - '#8000FF'
    - '#B000FF'
    - '#FF00FF'
    - '#FF0080'
    - '#FF0040'
    below_range: null
    unknown_state: '#646464'
    no_data: '#000000'
    states:
      'on':
        colour: '#FF0040'
        means: Busy
        note: ''
      'off':
        colour: '#00C853'
        means: Free
        note: ''
