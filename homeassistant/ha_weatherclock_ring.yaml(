# Home Assistant template sensor for the WeatherClock ring.
# Add this under your existing "template:" key, or paste the whole block if you
# have none. It maps the 36-hour forecast from sensor.weather_hourly to 36 solid
# RGB LED colors on the ring.
#
# Output is a 216-character string: 36 colours, 6 hex digits each (RRGGBB).
# LED 0 represents the current hour at full brightness; LEDs 1–35 show the next
# 35 hours dimmed slightly so "now" stands out at a glance.

template:
  - sensor:
      - name: "WeatherClock Ring Colors"
        unique_id: weatherclock_ring_colors
        state: >
          {%- set weather_colors = {
            "sunny": [255, 215, 0],
            "clear-night": [15, 32, 67],
            "partlycloudy": [200, 225, 255],
            "cloudy": [112, 128, 144],
            "fog": [190, 190, 205],
            "rainy": [30, 144, 255],
            "pouring": [0, 0, 205],
            "snowy": [240, 248, 255],
            "snowy-rainy": [170, 130, 230],
            "hail": [221, 160, 221],
            "lightning": [255, 20, 147],
            "lightning-rainy": [75, 0, 130],
            "windy": [64, 224, 208],
            "windy-variant": [0, 139, 139],
            "exceptional": [255, 69, 0]
          } -%}
          
          {%- set forecast = state_attr('sensor.weather_hourly', 'forecast') or [] -%}
          {%- set o = namespace(s='') -%}
          
          {%- for k in range(36) -%}
            {%- if k < forecast | length -%}
              {%- set cond = forecast[k].condition -%}
              {%- set rgb = weather_colors.get(cond, [100, 100, 100]) -%}
            {%- else -%}
              {%- set rgb = [0, 0, 0] -%}
            {%- endif -%}

            {%- set dim = 1.0 if k == 0 else 0.40 -%}
            {%- set r = (rgb[0] * dim) | int -%}
            {%- set g = (rgb[1] * dim) | int -%}
            {%- set b = (rgb[2] * dim) | int -%}
            
            {%- set o.s = o.s ~ '%02x%02x%02x' | format(r, g, b) -%}
          {%- endfor -%}
          {{ o.s }}
